# ==============================================================================
# AI-BI 智能商业分析与决策平台 — 环境变量配置示例
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI 经营助手配置 (LangGraph ReAct 状态机驱动，支持 DeepSeek 等 OpenAI 兼容接口)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 2. 银豹 (PosPal) 收银系统凭据 (可选，未配置时自动降级至离线预热包/合成数据库)
# ------------------------------------------------------------------------------
# 银豹 Web 后台登录凭据 (主数据拉取通道)
POSPAL_USER=your_pospal_username
POSPAL_PASSWORD=your_password_here

# 银豹 OpenAPI 凭据 (可选，用于 pospal_api_fetch.py)
POSPAL_APP_ID=your_openapi_app_id
POSPAL_APP_KEY=your_openapi_app_key
POSPAL_API_BASE_URL=https://openapi.pospal.cn/pospal-api2/openapi/v1
POSPAL_SIGNATURE_VERSION=v1

# ------------------------------------------------------------------------------
# 3. 性能缓存与配额保护控制 (可选)
# ------------------------------------------------------------------------------
# 看板服务端缓存有效期 (秒，默认 900)
POSPAL_DASHBOARD_CACHE_TTL=900

# 当月数据刷新冷却 (秒，默认 6小时，保护接口免费额度)
POSPAL_CURRENT_MONTH_CACHE_TTL=21600

# 历史已封账月份缓存有效期 (秒，默认 30天)
POSPAL_HISTORICAL_CACHE_TTL=2592000

# ------------------------------------------------------------------------------
# 4. 气象服务配置 (Open-Meteo 免费逐日气象，无需 API Key)
# ------------------------------------------------------------------------------
STORE_WEATHER_LOCATION=示范城市 · 示范区
STORE_WEATHER_LATITUDE=22.81899
STORE_WEATHER_LONGITUDE=113.67306

# ------------------------------------------------------------------------------
# 5. 跨周期对比固定月份归档 (可选，逗号分隔，归档月份持久锁定永不过期)
# ------------------------------------------------------------------------------
POSPAL_ARCHIVE_MONTHS=2026-03,2026-06,2026-07,2026-08
